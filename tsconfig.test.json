{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@frontend/*": ["./frontend/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "frontend/**/*.test.tsx",
    "frontend/**/*.test.ts",
    "shared/**/*.test.ts",
    "tests/**/*.ts"
  ]
}
